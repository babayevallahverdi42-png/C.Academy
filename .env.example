# C. ACADEMY — Enterprise Server-Side & Mobile Proxy Configuration
# Never commit real API secrets to version control.
# Client-side requests route exclusively through /api/v1/proxy/* with SSL Pinning.

PORT=3000
NODE_ENV=production

# Server-Side Only Secrets (Never prefixed with VITE_)
GEMINI_API_KEY=your_server_side_gemini_api_key_here
PAYONEER_ENTERPRISE_CLIENT_ID=your_payoneer_client_id_here
PAYONEER_ENTERPRISE_CLIENT_SECRET=your_payoneer_client_secret_here
PAYONEER_WEBHOOK_HMAC_SECRET=your_payoneer_webhook_hmac_secret_here
JWT_SIGNING_PRIVATE_KEY_SECRET=your_256_bit_jwt_signing_secret_here

# Public Non-Sensitive Mobile / Client Config
VITE_API_PROXY_BASE_URL=/api/v1/proxy
VITE_SSL_PINNING_ENFORCED=true
